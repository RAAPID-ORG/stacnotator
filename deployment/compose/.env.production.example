APP_DOMAIN=annotate.example.org
CORS_ORIGINS=https://annotate.example.org
ENVIRONMENT=production
AUTH_PROVIDER=firebase

POSTGRES_DB=stacnotator
POSTGRES_USER=stacnotator
POSTGRES_PASSWORD=

FIREBASE_CREDENTIALS_PATH_HOST=/absolute/path/to/firebase-service-account.json
VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Leave empty for same-origin requests through the HTTPS gateway.
VITE_API_BASE_URL_PROD=

# Generate separately: openssl rand -hex 32
TILER_TOKEN_SECRET=
# Generate: openssl rand -base64 32
APIKEY_ENCRYPTION_SECRET=

# One worker uses at most 30 DB connections with the default pool settings.
WORKERS=1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Optional Earth Engine features:
# EE_SERVICE_ACCOUNT=service-account@project.iam.gserviceaccount.com
# EE_PRIVATE_KEY_PATH_HOST=/absolute/path/to/earth-engine-service-account.json

# Optional hosted tiler, deployed separately:
# TILERS={"hosted":{"url":"https://tiler.example.org","allows_ingest":true}}
# DEFAULT_TILER=hosted
# TILER_COOKIE_DOMAIN=.example.org
