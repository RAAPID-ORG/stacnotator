# Local Azure deployment configuration.
#
# This file is only for running deploy.sh / bootstrap.sh from a developer laptop. CI
# does NOT use it: there, every value below comes from the job's GitHub Environment
# as an environment-scoped secret or variable.
#
#   cp deployment/azure/.env.deploy.example deployment/azure/.env.deploy.dev
#   ./deployment/azure/bootstrap.sh dev     # once per environment
#   ./deployment/azure/deploy.sh dev        # every release
#
# Anything already set in the environment wins over this file.

# Required: the project's resource group.
RESOURCE_GROUP=your-resource-group-name

# Required for the hosted tiler to render in a browser. The frontend, backend and
# tiler are served at app. / api. / tiler.<this>, and the tiler-access cookie is
# scoped to .<this> so the browser sends it to the tiler same-site. The custom
# domains must be bound to the Static Web App and Container Apps first (see README).
# Without it, MPC imagery works but hosted-tiler tiles 401.
PUBLIC_DOMAIN=dev.example.org

# Earth Engine service account the backend authenticates as.
EE_SERVICE_ACCOUNT=your-sa@your-project.iam.gserviceaccount.com

# bootstrap.sh only: local paths to the credential JSON files it uploads.
FIREBASE_CREDS=backend/config/firebase-credentials.json
EE_CREDS=backend/config/ee-private-key.json

# bootstrap.sh only: Firebase client config for the frontend build. Not secret, it
# ships inside the bundle.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Optional: extra origins appended to CORS_ORIGINS. Comma-separated, no trailing slash.
# CUSTOM_DOMAINS=https://www.example.org,https://example.org

# Optional: register additional, externally-hosted tilers in the backend's TILERS
# registry. Inner JSON entries WITHOUT outer braces; comma-separate multiple.
# allows_ingest:false for tilers preloaded with a build-stac catalog.
# EXTRA_TILERS="tiler-gcp":{"url":"https://tiler-gcp.example.org","internal_url":"https://tiler-gcp.example.org","allows_ingest":false}

# Optional: let the tiler read internal-storage custom-map COGs via the managed
# identity instead of a SAS.
# TILER_AZURE_SIGNING=true

# Optional: place the tiler on a dedicated D8 workload profile (bootstrap.sh adds it).
# TILER_DEDICATED=true

# Optional: override the image tag (defaults to the git commit SHA).
# IMAGE_TAG=v1.0.0
