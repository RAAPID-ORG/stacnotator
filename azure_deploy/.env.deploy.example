# Azure Deployment Configuration
#
# Create per-environment files:
#   cp azure_deploy/.env.deploy.example azure_deploy/.env.deploy.prod
#   cp azure_deploy/.env.deploy.example azure_deploy/.env.deploy.dev
#
# Then pass prod or dev as an argument to the scripts:
#   ./azure_deploy/deploy-app.sh prod

# Environment name (prod|dev)
DEPLOY_ENV=prod

# Azure Resource Group (required for all deploy scripts)
RESOURCE_GROUP=your-resource-group-name

# Credentials (used by upload-secrets.sh and deploy-app.sh)
FIREBASE_CREDS=backend/config/firebase-credentials.json
EE_CREDS=backend/config/ee-private-key.json
EE_SERVICE_ACCOUNT=your-sa@your-project.iam.gserviceaccount.com
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Optional: extra origins appended to CORS_ORIGINS alongside the generated
# SWA hostname. Comma-separated, no trailing slashes.
# CUSTOM_DOMAINS=https://www.stacnotator.io,https://stacnotator.io

# Shared parent domain for this env. REQUIRED for the hosted tiler to render in a
# browser: the frontend/backend/tiler are served at app./api./tiler.<this> and the
# tiler-access cookie is scoped to .<this> so it reaches the tiler same-site. The
# custom domains must be bound to the SWA + Container Apps first (see README).
# Without it, MPC imagery works but hosted-tiler tiles 401 (cross-domain cookie).
# PUBLIC_DOMAIN=dev.stacnotator.io        # prod e.g. stacnotator.io

# Optional: register additional, externally-hosted tilers (e.g. a GCP VM tiler) in
# the backend's TILERS registry. Inner JSON entries WITHOUT outer braces; comma-
# separate multiple. allows_ingest:false for build-stac-preloaded tilers (Planet).
# EXTRA_TILERS="tiler-gcp":{"url":"https://tiler-gcp.dev.stacnotator.io","internal_url":"https://tiler-gcp.dev.stacnotator.io","allows_ingest":false}

# Optional: override image tag (defaults to git commit SHA)
# IMAGE_TAG=v1.0.0
