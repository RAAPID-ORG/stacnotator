{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "openapi-ts": "openapi-ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "benchmark:campaign-113": "RUN_CAMPAIGN_BENCHMARK=1 playwright test e2e/campaign-113-benchmark.spec.ts --project=chromium --workers=1 --reporter=line"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@tanstack/react-query": "^5.102.2",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "firebase": "^12.7.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.6.0",
    "ml-savitzky-golay": "^5.0.0",
    "ol": "^10.8.0",
    "ol-mapbox-style": "^13.4.3",
    "ol-pmtiles": "^2.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-grid-layout": "^2.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.15.1",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.10",
    "@eslint/js": "^9.18.0",
    "@hey-api/openapi-ts": "0.89.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.5",
    "vite-plugin-compression2": "^2.5.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  }
}
